rules_version = '2';

// Reglas de seguridad de Cloud Firestore — HU-11, HU-15, HU-18 a HU-21 · RNF-05, RNF-08
//
// El control de acceso vive en dos capas simultáneas: la interfaz oculta lo que el rol no
// puede usar, y estas reglas rechazan la operación aunque se intente desde fuera de la
// interfaz. Una sin la otra no satisface RNF-08.
//
// Modelo de datos documentado en docs/04-modelo-datos.md.
// Verificación paso a paso en docs/06-puesta-en-marcha.md §1.6.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- ayudas

    function autenticado() {
      return request.auth != null;
    }

    function miUid() {
      return request.auth.uid;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(miUid())).data;
    }

    function tengoRol(rol) {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(miUid()))
        && miPerfil().rol == rol
        && miPerfil().estado == 'activo';
    }

    function soyAdmin() {
      return tengoRol('administrador');
    }

    // ¿La actualización toca alguno de estos campos?
    function toca(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // Forma mínima de un perfil de actor cultural (HU-18 · docs/04 §4).
    //
    // 'hasOnly' cierra la puerta a campos inventados: sin él, cualquiera podría
    // añadir a su propio perfil una clave que la interfaz nunca pinta y que
    // acabaría viajando al navegador de todo visitante, porque el perfil se lee
    // entero y en público.
    function perfilDeActorBienFormado() {
      let d = request.resource.data;
      return d.keys().hasOnly(['idActor', 'uid', 'nombre', 'manifestacion',
                               'descripcion', 'categoria', 'contacto', 'redes',
                               'imagen', 'estado'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.manifestacion is string
        && d.manifestacion.size() > 0 && d.manifestacion.size() <= 120
        && d.descripcion is string
        && d.descripcion.size() > 0 && d.descripcion.size() <= 1000
        && d.categoria is string && d.categoria.size() > 0
        && d.contacto is map
        && imagenAceptable();
    }

    // La imagen del perfil viaja DENTRO del documento, como URI de datos, y no
    // en Firebase Storage: activarlo exige plan de facturación con medio de pago
    // y el proyecto no lo tiene (docs/03-arquitectura.md §6.1).
    //
    // Eso obliga a poner aquí el límite que en Storage habría puesto
    // «request.resource.size». Sin él, el documento admitiría hasta el máximo de
    // Firestore, un megabyte, y cada visitante del directorio se descargaría eso
    // por cada perfil. Los dos criterios de HU-19 —formato y tamaño— siguen
    // comprobándose en el servidor, que es lo que exige RNF-08.
    //
    // Se usa «get» con valor por omisión porque la imagen es opcional: leer una
    // clave ausente haría fallar la expresión entera, que es exactamente el
    // defecto que HU-18 encontró con «resource» nulo (docs/17 §10).
    function imagenAceptable() {
      let imagen = request.resource.data.get('imagen', null);
      return imagen == null
        || (imagen is string
            && imagen.size() < 120000
            && imagen.matches('^data:image/(jpeg|png);base64,.*'));
    }

    // Un punto en el mapa, cuando lo hay (HU-22 lo rellena; HU-21 lo deja nulo).
    function puntoAceptable() {
      let punto = request.resource.data.get('coordenadas', null);
      return punto == null || punto is latlng;
    }

    // El título normalizado no lo escribe una persona: lo calcula el cliente para
    // que la búsqueda de HU-27 no distinga mayúsculas ni tildes. Y ahí está el
    // problema: **nadie lo mira nunca**. El moderador de HU-24 aprueba leyendo
    // «titulo», así que un «tituloNormalizado» que dijera otra cosa entraría al
    // catálogo sin que nadie lo notase, y respondería a búsquedas que no le
    // corresponden.
    //
    // Las reglas no saben quitar tildes, así que no pueden recalcularlo. Lo que
    // sí pueden es exigir lo que la normalización nunca cambia: no añade letras
    // ni deja mayúsculas.
    function tituloNormalizadoCoherente() {
      let d = request.resource.data;
      return d.tituloNormalizado is string
        && d.tituloNormalizado == d.tituloNormalizado.lower()
        && d.tituloNormalizado.size() == d.titulo.size();
    }

    // Forma de una publicación (HU-21 · docs/04 §6).
    //
    // Los topes de longitud son más anchos que los del formulario a propósito, y
    // por el motivo de docs/18 §2: el del formulario es una promesa de que el
    // texto se verá bien, y este es el techo del abuso. Si los dos fueran el
    // mismo número, cualquier desacuerdo entre cómo cuenta caracteres el
    // navegador y cómo los cuenta una regla se convertiría en un rechazo que
    // quien escribe no puede entender ni corregir.
    function publicacionBienFormada() {
      let d = request.resource.data;
      return d.keys().hasOnly(['idEvento', 'idActor', 'titulo', 'tituloNormalizado',
                               'descripcion', 'categoria', 'fechaInicio', 'fechaFin',
                               'lugar', 'coordenadas', 'imagen', 'estadoPublicacion',
                               'fechaCreacion', 'contadorConsultas'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && tituloNormalizadoCoherente()
        && d.descripcion is string
        && d.descripcion.size() > 0 && d.descripcion.size() <= 4000
        && d.categoria is string && d.categoria.size() > 0
        && d.fechaInicio is timestamp
        && d.fechaFin is timestamp
        && d.fechaInicio <= d.fechaFin
        && d.lugar is string && d.lugar.size() > 0 && d.lugar.size() <= 300
        && puntoAceptable()
        && imagenAceptable();
    }

    // El actor cultural identificado por idActor pertenece a quien hace la petición.
    function soyDuenoDelActor(idActor) {
      return autenticado()
        && exists(/databases/$(database)/documents/actoresCulturales/$(idActor))
        && get(/databases/$(database)/documents/actoresCulturales/$(idActor)).data.uid == miUid();
    }

    // ---------------------------------------------------------------- usuarios
    // El id del documento ES el uid de Firebase Authentication (docs/04 §3).

    match /usuarios/{uid} {
      allow get: if autenticado() && (miUid() == uid || soyAdmin());
      allow list: if soyAdmin();

      // Solo puedes crear tu propio documento, y el consentimiento es obligatorio (HU-16).
      //
      // El rol NO incluye 'administrador': quien se registra elige entre actor y
      // hub, y nada más. Admitirlo aquí dejaba que cualquiera creara su propio
      // documento con rol de administrador y obtuviera el panel de moderación,
      // porque soyAdmin() lee justamente este documento (HU-15, docs/15 §5). La
      // cuenta de administrador se crea desde la consola de Firebase, que no pasa
      // por estas reglas (docs/06 §1.7).
      allow create: if autenticado()
        && miUid() == uid
        && request.resource.data.uid == uid
        && request.resource.data.rol in ['actor', 'hub']
        && request.resource.data.estado == 'activo'
        && request.resource.data.consentimientoDatos.aceptado == true
        && request.resource.data.consentimientoDatos.version is string
        && request.resource.data.fechaRegistro == request.time
        && request.resource.data.consentimientoDatos.fecha == request.time;

      // Nadie se cambia el rol ni el estado a sí mismo: eso es potestad del administrador.
      allow update: if (autenticado()
                        && miUid() == uid
                        && !toca(['rol', 'estado', 'uid', 'consentimientoDatos', 'fechaRegistro']))
                    || soyAdmin();

      allow delete: if soyAdmin();
    }

    // ---------------------------------------------------------------- actoresCulturales

    // El id del documento ES el uid de su dueño, igual que en 'usuarios'.
    //
    // No es una comodidad de escritura: es la única forma de que estas reglas
    // garanticen «un actor, un perfil» (docs/04 §2). Con un identificador
    // generado nada impediría a la misma cuenta crear veinte perfiles, porque
    // desde aquí no se puede consultar si ya existe otro documento con ese uid
    // —solo se puede comprobar la existencia de una ruta concreta—, y esa ruta
    // concreta solo se conoce si el uid es el identificador. Véase docs/17 §2.

    match /actoresCulturales/{idActor} {
      // Público solo lo aprobado; el dueño y el administrador ven también lo pendiente.
      //
      // La primera condición es la que permite leer un documento que NO EXISTE.
      // Sin ella, quien todavía no ha creado su perfil recibe un
      // «Missing or insufficient permissions» al abrir /mi-perfil: sobre un
      // documento inexistente `resource` llega nulo, `resource.data.estado`
      // falla, y con ella falla la expresión entera. No abre nada: solo se puede
      // preguntar por la propia ruta, porque el identificador ES el uid, y la
      // respuesta —«no tienes perfil»— ya la conoce quien pregunta.
      allow read: if (resource == null && autenticado() && idActor == miUid())
                  || resource.data.estado == 'aprobado'
                  || (autenticado() && resource.data.uid == miUid())
                  || soyAdmin();

      allow create: if tengoRol('actor')
        && idActor == miUid()
        && request.resource.data.uid == miUid()
        && request.resource.data.idActor == idActor
        && request.resource.data.estado == 'pendiente'
        && perfilDeActorBienFormado();

      // El perfil se edita sin volver a aprobación (HU-18, segundo criterio),
      // pero el dueño no se autoaprueba: 'estado' solo lo mueve el administrador.
      allow update: if (autenticado()
                        && resource.data.uid == miUid()
                        && !toca(['uid', 'idActor', 'estado'])
                        && perfilDeActorBienFormado())
                    || soyAdmin();

      allow delete: if (autenticado() && resource.data.uid == miUid()) || soyAdmin();
    }

    // ---------------------------------------------------------------- hubs
    // Gemelo de actoresCulturales, y por las mismas razones: el id ES el uid, de
    // modo que «un responsable, un hub» sea algo que las reglas puedan
    // garantizar y no solo algo que el modelo declare (docs/19 §2).

    // Forma mínima de un hub de innovación (HU-20 · docs/04 §5).
    function hubBienFormado() {
      let d = request.resource.data;
      return d.keys().hasOnly(['idHub', 'uid', 'nombre', 'descripcion',
                               'lineasDeTrabajo', 'direccion', 'coordenadas',
                               'contacto', 'estado'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.descripcion is string
        && d.descripcion.size() > 0 && d.descripcion.size() <= 1000
        && d.lineasDeTrabajo is list
        && d.lineasDeTrabajo.size() > 0 && d.lineasDeTrabajo.size() <= 8
        && d.direccion is string
        && d.direccion.size() > 0 && d.direccion.size() <= 200
        // 'latlng' es el tipo de un GeoPoint. Exigirlo aquí es lo que impide que
        // el mapa reciba un hub con dos cadenas de texto donde espera un punto,
        // y con él la consulta entera de HU-30.
        && d.coordenadas is latlng
        && d.contacto is map;
    }

    match /hubs/{idHub} {
      // La primera condición permite leer un documento que NO EXISTE, que es lo
      // que hace quien abre /mi-hub antes de crear el suyo. Sin ella, «resource»
      // llega nulo y la expresión entera falla — el defecto que HU-18 encontró
      // en producción (docs/17 §10).
      allow read: if (resource == null && autenticado() && idHub == miUid())
                  || resource.data.estado == 'aprobado'
                  || (autenticado() && resource.data.uid == miUid())
                  || soyAdmin();

      allow create: if tengoRol('hub')
        && idHub == miUid()
        && request.resource.data.uid == miUid()
        && request.resource.data.idHub == idHub
        && request.resource.data.estado == 'pendiente'
        && hubBienFormado();

      // Se edita sin volver a aprobación, igual que el perfil del actor; el
      // dueño no se autoaprueba.
      allow update: if (autenticado()
                        && resource.data.uid == miUid()
                        && !toca(['uid', 'idHub', 'estado'])
                        && hubBienFormado())
                    || soyAdmin();

      allow delete: if (autenticado() && resource.data.uid == miUid()) || soyAdmin();
    }

    // ---------------------------------------------------------------- eventos

    match /eventos/{idEvento} {
      // **Tercer criterio de HU-21**: sin aprobar no sale al catálogo. No lo
      // decide la vista al pintar, lo decide esto: una consulta de visitante que
      // alcance una publicación pendiente no devuelve menos filas, falla entera.
      //
      // «resource != null» va delante por la lección de HU-18 (docs/17 §10):
      // sobre un documento que no existe «resource» llega nulo y «resource.data»
      // no devuelve falso, revienta la expresión. Aquí sí se deniega —un
      // identificador de evento es aleatorio y nadie tiene por qué leer una ruta
      // vacía—, pero denegar y estallar no son lo mismo.
      allow read: if resource != null
                  && (resource.data.estadoPublicacion == 'aprobado'
                      || soyDuenoDelActor(resource.data.idActor)
                      || soyAdmin());

      // **Primer y cuarto criterio de HU-21.** Nace pendiente, con la fecha del
      // servidor y conservando de quién es.
      //
      // «fechaCreacion == request.time» es lo que hace verdadero el cuarto
      // criterio: obliga a que el cliente haya enviado «serverTimestamp()», que
      // es el único valor de tiempo que no puede inventarse. Sin esta línea, una
      // publicación podría nacer fechada el año pasado y colarse al principio de
      // la cola de moderación de HU-24.
      allow create: if tengoRol('actor')
        && soyDuenoDelActor(request.resource.data.idActor)
        && idEvento == request.resource.data.idEvento
        && request.resource.data.estadoPublicacion == 'pendiente'
        && request.resource.data.contadorConsultas == 0
        && request.resource.data.fechaCreacion == request.time
        && publicacionBienFormada();

      // Al editar vuelve a 'pendiente' (HU-23). El autor no se aprueba solo.
      allow update: if (soyDuenoDelActor(resource.data.idActor)
                        && !toca(['idEvento', 'idActor', 'fechaCreacion',
                                  'contadorConsultas'])
                        && request.resource.data.estadoPublicacion == 'pendiente'
                        && publicacionBienFormada())
                    || soyAdmin();

      allow delete: if soyDuenoDelActor(resource.data.idActor) || soyAdmin();
    }

    // ---------------------------------------------------------------- categorias

    match /categorias/{idCategoria} {
      allow read: if true;                 // los filtros públicos las necesitan

      allow create: if soyAdmin()          // RF-14
        && request.resource.data.keys().hasOnly(
             ['idCategoria', 'nombre', 'descripcion', 'activa'])
        && request.resource.data.idCategoria == idCategoria
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.activa is bool;

      // El identificador no cambia al renombrar: es lo que llevan escrito dentro
      // las publicaciones ya clasificadas (eventos.categoria).
      allow update: if soyAdmin()
        && !toca(['idCategoria'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 60;

      // Una categoría NO se elimina, se desactiva con «activa: false» (HU-17).
      //
      // Las reglas no pueden contar los eventos que la usan —no existe consulta
      // a otra colección desde aquí—, así que una regla que permitiera borrar
      // «solo si no está en uso» sería una promesa que el servidor no puede
      // cumplir: el recuento lo aportaría el cliente, y el cliente puede mentir.
      // Negarlo siempre es la única garantía real de que ninguna publicación se
      // quede sin clasificación (docs/16-categorias.md §3).
      allow delete: if false;
    }

    // ---------------------------------------------------------------- moderaciones
    // Registro inmutable: se crea, nunca se edita ni se borra (docs/04 §8).

    match /moderaciones/{idModeracion} {
      allow read: if soyAdmin()
                  || (exists(/databases/$(database)/documents/eventos/$(resource.data.idEvento))
                      && soyDuenoDelActor(
                           get(/databases/$(database)/documents/eventos/$(resource.data.idEvento)).data.idActor));

      allow create: if soyAdmin()
        && request.resource.data.idAdministrador == miUid()
        && request.resource.data.decision in ['aprobado', 'devuelto']
        && request.resource.data.fecha == request.time
        // devolver exige observación escrita (HU-24)
        && (request.resource.data.decision == 'aprobado'
            || (request.resource.data.observaciones is string
                && request.resource.data.observaciones.size() > 0));

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- interacciones
    // Registro anonimizado. Cualquiera puede añadir uno; solo el administrador los lee.
    // Nunca debe contener datos personales identificables del visitante (RNF-06, HU-34).

    match /interacciones/{idInteraccion} {
      allow read: if soyAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                         ['idInteraccion', 'idEvento', 'tipo', 'fecha'])
        && request.resource.data.tipo in ['consulta', 'contacto']
        && request.resource.data.fecha == request.time;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- resto
    // Cierre por defecto: lo que no esté declarado arriba queda denegado.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
